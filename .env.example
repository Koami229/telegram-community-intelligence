# Telegram API credentials from https://my.telegram.org/apps
TELEGRAM_API_ID=0
TELEGRAM_API_HASH=
TELEGRAM_PHONE=
TELEGRAM_SESSION_NAME=tci_session
TELEGRAM_SESSION_PATH=sessions

# PostgreSQL
DATABASE_URL=postgresql+psycopg://tci_user:tci_password@localhost:5433/tci_db

# API protection: set a long random value before exposing the API
INGESTION_API_KEY=

# Media downloads are disabled by default
MEDIA_DOWNLOAD_ENABLED=false
MEDIA_STORAGE_PATH=media
MEDIA_MAX_SIZE_BYTES=52428800
MEDIA_RETENTION_DAYS=0
MEDIA_ALLOWED_MIME_TYPES=image/jpeg,image/png,image/gif,video/mp4,audio/mpeg,audio/ogg,application/pdf

HOST=0.0.0.0
PORT=8000
DEBUG=false
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
